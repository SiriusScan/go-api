{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siriusscan.github.io/contracts/message/v1/scan-job.schema.json",
  "type": "object",
  "required": ["scan_id", "targets", "options"],
  "properties": {
    "scan_id": {"type":"string", "minLength":1},
    "targets": {"type":"array", "minItems":1, "items":{"type":"object", "required":["value","type"], "properties":{"value":{"type":"string","minLength":1},"type":{"type":"string","minLength":1},"timeout":{"type":"integer"}}}},
    "options": {"type":"object"},
    "priority": {"type":"integer"},
    "callback_url": {"type":"string"},
    "state_mode": {"type":"string"}
  }
}
